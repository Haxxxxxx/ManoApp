rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Global catch-all: require authentication for all paths
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Allow access to music files for authenticated users
    match /music-files/{tripId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Allow access to cover art for authenticated users
    match /cover-art/{tripId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Allow access to shared drive files for authenticated users
    match /shared-drive/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Allow access to notion templates for authenticated users
    match /notion-templates/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Allow access to stems for authenticated users
    match /stems/{tripId}/{songId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Allow access to user-specific files (only owner can write)
    match /users/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }
  }
}
