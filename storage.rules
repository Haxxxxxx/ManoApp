rules_version = '2';

// Locked down from an authenticated catch-all (2026-06-11). Every match below
// corresponds to a path the client actually uses — see the upload-path audit
// in PR #3. Anything unmatched is denied, including:
//   - assets/{userId}/** : written/read server-side only (Drive imports)
//   - music-files/**     : legacy rule target, never written by the app
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Owner or collaborator on the trip (project) document
    function hasTripAccess(tripId) {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/trips/$(tripId)) &&
        (
          firestore.get(/databases/(default)/documents/trips/$(tripId)).data.userId == request.auth.uid ||
          request.auth.uid in firestore.get(/databases/(default)/documents/trips/$(tripId)).data.collaborators
        );
    }

    // Deletes have no request.resource; uploads must be audio within the
    // client-side limit (utils/constants.ts AUDIO_STORAGE = 100MB)
    function isAudioUpload() {
      return request.resource == null ||
        (request.resource.size <= 100 * 1024 * 1024 &&
         request.resource.contentType.matches('audio/.*'));
    }

    function isImageUpload() {
      return request.resource == null ||
        (request.resource.size <= 20 * 1024 * 1024 &&
         request.resource.contentType.matches('image/.*'));
    }

    // Song audio files — written by uploadMusicFile as music/{tripId}/{file}
    match /music/{tripId}/{fileName} {
      allow read: if hasTripAccess(tripId);
      allow write: if hasTripAccess(tripId) && isAudioUpload();
    }

    // Stems — uploadStemFiles / useAudioMixer
    match /stems/{tripId}/{songId}/{fileName} {
      allow read: if hasTripAccess(tripId);
      allow write: if hasTripAccess(tripId) && isAudioUpload();
    }

    // Empty marker object created per song by createSong
    match /projects/{tripId}/{songId} {
      allow read: if hasTripAccess(tripId);
      allow write: if hasTripAccess(tripId) && request.resource.size < 1024;
    }

    // Cover art — the first segment is a tripId, songId, OR albumId depending
    // on caller (uploadCoverArt), so it cannot be foreign-key checked against
    // trips. Constrain to authenticated image uploads instead.
    match /cover-art/{ownerId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isImageUpload();
    }
    match /cover-art/{ownerId}/{songId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isImageUpload();
    }

    // Shared drive + Notion templates — app-provided content, read-only for
    // clients (uploaded out-of-band via console/Admin SDK)
    match /shared-drive/{fileName} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    match /notion-templates/{fileName} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // User-owned files — no current client writes, kept for profile uploads
    match /users/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
