# Firebase Web App Config (safe to ship to the client)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Local emulator suite — set to "true" only via `npm run dev:emu`.
# When on, the client talks to the Auth/Firestore/Storage/Functions emulators
# on 127.0.0.1 instead of production. Required for the dev bypass button
# (anonymous sign-in is disabled in production Firebase).
VITE_USE_EMULATORS=false

# NOTE: Do NOT put Admin SDK credentials (service-account private key /
# client email) here. Anything with a VITE_ prefix is bundled into the public
# client JS. Admin credentials belong only in the Cloud Functions runtime
# (functions/.env or `firebase functions:config`), never in this file.
