import React, { useState, FC, useEffect } from 'react';
import {
  Box,
  Typography,
  Paper,
  Tabs,
  Tab,
  TextField,
  Button,
  Switch,
  FormControlLabel,
  Divider,
  Alert,
  CircularProgress,
  List,
  ListItem,
  ListItemText,
  ListItemIcon,
  ListItemSecondaryAction,
  IconButton,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  useTheme,
  alpha,
  LinearProgress,
  Slider,
  InputAdornment,
  Grid,
  Card,
  CardContent,
  Tooltip,
  Select,
  MenuItem,
  FormControl,
  InputLabel,
} from '@mui/material';
import {
  Person as PersonIcon,
  Notifications as NotificationsIcon,
  Security as SecurityIcon,
  Storage as StorageIcon,
  Palette as PaletteIcon,
  Language as LanguageIcon,
  Delete as DeleteIcon,
  Edit as EditIcon,
  Save as SaveIcon,
  Cancel as CancelIcon,
  ColorLens as ColorLensIcon,
  DarkMode as DarkModeIcon,
  TextFields as TextFieldsIcon,
  Animation as AnimationIcon,
  BorderRadius as BorderRadiusIcon,
  SpaceBar as SpaceBarIcon,
  FontDownload as FontDownloadIcon,
} from '@mui/icons-material';
import { useAuth } from '../../contexts/AuthContext';
import { updateUserProfile, deleteAccount } from '../../services/firebaseService';
import { createTheme, ThemeProvider } from '@mui/material/styles';
import { useThemeSettings, ThemeSettings } from '../../contexts/ThemeContext';
import { ChromePicker } from 'react-color';

interface TabPanelProps {
  children?: React.ReactNode;
  index: number;
  value: number;
}

function TabPanel(props: TabPanelProps) {
  const { children, value, index, ...other } = props;

  return (
    <div
      role="tabpanel"
      hidden={value !== index}
      id={`settings-tabpanel-${index}`}
      aria-labelledby={`settings-tab-${index}`}
      {...other}
    >
      {value === index && (
        <Box sx={{ p: 3 }}>
          {children}
        </Box>
      )}
    </div>
  );
}

interface SettingsPanelProps {
  onClose: () => void;
}

const SettingsPanel: FC<SettingsPanelProps> = ({ onClose }) => {
  const theme = useTheme();
  const { currentUser, artistProfile, updateProfile } = useAuth();
  const [activeTab, setActiveTab] = useState(0);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [success, setSuccess] = useState<string | null>(null);
  const [deleteConfirmOpen, setDeleteConfirmOpen] = useState(false);
  const [editingProfile, setEditingProfile] = useState(false);
  const [profileData, setProfileData] = useState({
    name: artistProfile?.name || '',
    bio: artistProfile?.bio || '',
    genre: artistProfile?.genre || '',
    location: artistProfile?.location || '',
    photoURL: artistProfile?.photoURL || currentUser?.photoURL || '',
    socialLinks: artistProfile?.socialLinks || {},
  });
  const { settings, updateSettings } = useThemeSettings();
  const [localSettings, setLocalSettings] = useState<ThemeSettings>(settings);
  const [showPrimaryColorPicker, setShowPrimaryColorPicker] = useState(false);
  const [showSecondaryColorPicker, setShowSecondaryColorPicker] = useState(false);
  const [primaryColorAnchor, setPrimaryColorAnchor] = useState<HTMLElement | null>(null);
  const [secondaryColorAnchor, setSecondaryColorAnchor] = useState<HTMLElement | null>(null);

  // Update local settings when context settings change
  useEffect(() => {
    setLocalSettings(settings);
  }, [settings]);

  const handleTabChange = (event: React.SyntheticEvent, newValue: number) => {
    setActiveTab(newValue);
  };

  const handleProfileChange = (field: string) => (event: React.ChangeEvent<HTMLInputElement>) => {
    setProfileData({
      ...profileData,
      [field]: event.target.value,
    });
  };

  const handleSocialLinkChange = (platform: string) => (event: React.ChangeEvent<HTMLInputElement>) => {
    setProfileData({
      ...profileData,
      socialLinks: {
        ...profileData.socialLinks,
        [platform]: event.target.value,
      },
    });
  };

  const handleSaveProfile = async () => {
    if (!currentUser) return;
    
    setLoading(true);
    setError(null);
    
    try {
      await updateProfile(profileData);
      setEditingProfile(false);
      setSuccess('Profile updated successfully');
      setTimeout(() => setSuccess(null), 3000);
    } catch (err) {
      setError('Failed to update profile');
      console.error(err);
    } finally {
      setLoading(false);
    }
  };

  const handleDeleteAccount = async () => {
    if (!currentUser) return;
    
    setLoading(true);
    setError(null);
    
    try {
      await deleteAccount(currentUser.uid);
      setDeleteConfirmOpen(false);
      // Redirect will be handled by AuthContext
    } catch (err) {
      setError('Failed to delete account');
      console.error(err);
    } finally {
      setLoading(false);
    }
  };

  const handleSettingChange = (key: keyof ThemeSettings, value: any) => {
    setLocalSettings({
      ...localSettings,
      [key]: value,
    });
  };

  const handleSave = async () => {
    try {
      await updateSettings(localSettings);
      setSuccess('Settings saved successfully');
      setTimeout(() => setSuccess(null), 3000);
    } catch (err) {
      setError('Failed to save settings');
      console.error(err);
    }
  };

  const handleCancel = () => {
    setLocalSettings(settings);
  };

  const handlePrimaryColorClick = (event: React.MouseEvent<HTMLElement>) => {
    setPrimaryColorAnchor(event.currentTarget);
    setShowPrimaryColorPicker(true);
  };

  const handleSecondaryColorClick = (event: React.MouseEvent<HTMLElement>) => {
    setSecondaryColorAnchor(event.currentTarget);
    setShowSecondaryColorPicker(true);
  };

  const handleCloseColorPickers = () => {
    setShowPrimaryColorPicker(false);
    setShowSecondaryColorPicker(false);
  };

  const handlePrimaryColorChange = (color: any) => {
    handleSettingChange('primaryColor', color.hex);
  };

  const handleSecondaryColorChange = (color: any) => {
    handleSettingChange('secondaryColor', color.hex);
  };

  const fontFamilies = [
    '"Roboto", "Helvetica", "Arial", sans-serif',
    '"Poppins", "Helvetica", "Arial", sans-serif',
    '"Montserrat", "Helvetica", "Arial", sans-serif',
    '"Open Sans", "Helvetica", "Arial", sans-serif',
    '"Lato", "Helvetica", "Arial", sans-serif',
  ];

  return (
    <Paper 
      elevation={3} 
      sx={{ 
        height: '100%', 
        display: 'flex', 
        flexDirection: 'column',
        borderRadius: theme.shape.borderRadius,
        overflow: 'hidden',
      }}
    >
      <Box sx={{ borderBottom: 1, borderColor: 'divider', bgcolor: 'primary.main', color: 'primary.contrastText' }}>
        <Tabs 
          value={activeTab} 
          onChange={handleTabChange} 
          variant="fullWidth"
          sx={{
            '& .MuiTab-root': {
              color: 'rgba(255, 255, 255, 0.7)',
              '&.Mui-selected': {
                color: 'white',
              },
            },
            '& .MuiTabs-indicator': {
              backgroundColor: 'white',
            },
          }}
        >
          <Tab icon={<PersonIcon />} label="Profile" />
          <Tab icon={<PaletteIcon />} label="Theme" />
          <Tab icon={<SecurityIcon />} label="Security" />
        </Tabs>
      </Box>

      {error && (
        <Alert severity="error" sx={{ m: 2 }}>
          {error}
        </Alert>
      )}

      {success && (
        <Alert severity="success" sx={{ m: 2 }}>
          {success}
        </Alert>
      )}

      <TabPanel value={activeTab} index={0}>
        <Box sx={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
          <Typography variant="h5" gutterBottom>
            Profile Settings
          </Typography>
          
          {!editingProfile ? (
            <Box sx={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
              <Box sx={{ display: 'flex', alignItems: 'center', gap: 2 }}>
                <Avatar 
                  src={profileData.photoURL} 
                  sx={{ width: 80, height: 80 }}
                />
                <Box>
                  <Typography variant="h6">{profileData.name || 'No name set'}</Typography>
                  <Typography variant="body2" color="text.secondary">
                    {profileData.email || 'No email set'}
                  </Typography>
                </Box>
                <Button 
                  startIcon={<EditIcon />} 
                  onClick={() => setEditingProfile(true)}
                  sx={{ ml: 'auto' }}
                >
                  Edit
                </Button>
              </Box>
              
              <Divider />
              
              <Box>
                <Typography variant="subtitle1" gutterBottom>Bio</Typography>
                <Typography variant="body1">{profileData.bio || 'No bio set'}</Typography>
              </Box>
              
              <Box>
                <Typography variant="subtitle1" gutterBottom>Genre</Typography>
                <Typography variant="body1">{profileData.genre || 'No genre set'}</Typography>
              </Box>
              
              <Box>
                <Typography variant="subtitle1" gutterBottom>Location</Typography>
                <Typography variant="body1">{profileData.location || 'No location set'}</Typography>
              </Box>
              
              <Box>
                <Typography variant="subtitle1" gutterBottom>Social Links</Typography>
                {Object.entries(profileData.socialLinks || {}).length > 0 ? (
                  <List>
                    {Object.entries(profileData.socialLinks).map(([platform, url]) => (
                      <ListItem key={platform}>
                        <ListItemText 
                          primary={platform.charAt(0).toUpperCase() + platform.slice(1)} 
                          secondary={url} 
                        />
                      </ListItem>
                    ))}
                  </List>
                ) : (
                  <Typography variant="body2" color="text.secondary">No social links set</Typography>
                )}
              </Box>
            </Box>
          ) : (
            <Box sx={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
              <TextField
                label="Name"
                value={profileData.name}
                onChange={handleProfileChange('name')}
                fullWidth
                margin="normal"
              />
              
              <TextField
                label="Bio"
                value={profileData.bio}
                onChange={handleProfileChange('bio')}
                fullWidth
                margin="normal"
                multiline
                rows={3}
              />
              
              <TextField
                label="Genre"
                value={profileData.genre}
                onChange={handleProfileChange('genre')}
                fullWidth
                margin="normal"
              />
              
              <TextField
                label="Location"
                value={profileData.location}
                onChange={handleProfileChange('location')}
                fullWidth
                margin="normal"
              />
              
              <Typography variant="subtitle1" gutterBottom>Social Links</Typography>
              <TextField
                label="Instagram"
                value={profileData.socialLinks.instagram || ''}
                onChange={handleSocialLinkChange('instagram')}
                fullWidth
                margin="normal"
              />
              <TextField
                label="Twitter"
                value={profileData.socialLinks.twitter || ''}
                onChange={handleSocialLinkChange('twitter')}
                fullWidth
                margin="normal"
              />
              <TextField
                label="Facebook"
                value={profileData.socialLinks.facebook || ''}
                onChange={handleSocialLinkChange('facebook')}
                fullWidth
                margin="normal"
              />
              <TextField
                label="YouTube"
                value={profileData.socialLinks.youtube || ''}
                onChange={handleSocialLinkChange('youtube')}
                fullWidth
                margin="normal"
              />
              <TextField
                label="SoundCloud"
                value={profileData.socialLinks.soundcloud || ''}
                onChange={handleSocialLinkChange('soundcloud')}
                fullWidth
                margin="normal"
              />
              
              <Box sx={{ display: 'flex', justifyContent: 'flex-end', gap: 1, mt: 2 }}>
                <Button 
                  variant="outlined" 
                  onClick={() => setEditingProfile(false)}
                  startIcon={<CancelIcon />}
                >
                  Cancel
                </Button>
                <Button 
                  variant="contained" 
                  onClick={handleSaveProfile}
                  startIcon={<SaveIcon />}
                  disabled={loading}
                >
                  {loading ? <CircularProgress size={24} /> : 'Save'}
                </Button>
              </Box>
            </Box>
          )}
          
          <Divider sx={{ my: 2 }} />
          
          <Box>
            <Typography variant="h6" color="error" gutterBottom>
              Danger Zone
            </Typography>
            <Button 
              variant="outlined" 
              color="error" 
              startIcon={<DeleteIcon />}
              onClick={() => setDeleteConfirmOpen(true)}
            >
              Delete Account
            </Button>
          </Box>
        </Box>
      </TabPanel>

      <TabPanel value={activeTab} index={1}>
        <Box sx={{ display: 'flex', flexDirection: 'column', gap: 3 }}>
          <Typography variant="h5" gutterBottom>
            Theme Settings
          </Typography>
          
          <Grid container spacing={3}>
            <Grid item xs={12} md={6}>
              <Card>
                <CardContent>
                  <Typography variant="h6" gutterBottom>
                    <ColorLensIcon sx={{ mr: 1, verticalAlign: 'middle' }} />
                    Colors
                  </Typography>
                  
                  <Box sx={{ mb: 3 }}>
                    <Typography variant="subtitle1" gutterBottom>Primary Color</Typography>
                    <Box 
                      sx={{ 
                        display: 'flex', 
                        alignItems: 'center',
                        gap: 2,
                      }}
                    >
                      <Box
                        sx={{
                          width: 40,
                          height: 40,
                          borderRadius: '50%',
                          bgcolor: localSettings.primaryColor,
                          border: `1px solid ${theme.palette.divider}`,
                          cursor: 'pointer',
                        }}
                        onClick={handlePrimaryColorClick}
                      />
                      <Typography>{localSettings.primaryColor}</Typography>
                    </Box>
                  </Box>
                  
                  <Box sx={{ mb: 3 }}>
                    <Typography variant="subtitle1" gutterBottom>Secondary Color</Typography>
                    <Box 
                      sx={{ 
                        display: 'flex', 
                        alignItems: 'center',
                        gap: 2,
                      }}
                    >
                      <Box
                        sx={{
                          width: 40,
                          height: 40,
                          borderRadius: '50%',
                          bgcolor: localSettings.secondaryColor,
                          border: `1px solid ${theme.palette.divider}`,
                          cursor: 'pointer',
                        }}
                        onClick={handleSecondaryColorClick}
                      />
                      <Typography>{localSettings.secondaryColor}</Typography>
                    </Box>
                  </Box>
                  
                  <FormControlLabel
                    control={
                      <Switch
                        checked={localSettings.darkMode}
                        onChange={(e) => handleSettingChange('darkMode', e.target.checked)}
                        color="primary"
                      />
                    }
                    label="Dark Mode"
                  />
                </CardContent>
              </Card>
            </Grid>
            
            <Grid item xs={12} md={6}>
              <Card>
                <CardContent>
                  <Typography variant="h6" gutterBottom>
                    <TextFieldsIcon sx={{ mr: 1, verticalAlign: 'middle' }} />
                    Typography
                  </Typography>
                  
                  <Box sx={{ mb: 3 }}>
                    <Typography variant="subtitle1" gutterBottom>Font Size</Typography>
                    <Slider
                      value={localSettings.fontSize}
                      onChange={(_, value) => handleSettingChange('fontSize', value)}
                      min={10}
                      max={20}
                      step={1}
                      marks
                      valueLabelDisplay="auto"
                    />
                  </Box>
                  
                  <Box sx={{ mb: 3 }}>
                    <Typography variant="subtitle1" gutterBottom>Font Family</Typography>
                    <FormControl fullWidth>
                      <Select
                        value={localSettings.fontFamily}
                        onChange={(e) => handleSettingChange('fontFamily', e.target.value)}
                        label="Font Family"
                      >
                        {fontFamilies.map((font) => (
                          <MenuItem key={font} value={font}>
                            {font.split(',')[0].replace(/['"]/g, '')}
                          </MenuItem>
                        ))}
                      </Select>
                    </FormControl>
                  </Box>
                </CardContent>
              </Card>
            </Grid>
            
            <Grid item xs={12} md={6}>
              <Card>
                <CardContent>
                  <Typography variant="h6" gutterBottom>
                    <BorderRadiusIcon sx={{ mr: 1, verticalAlign: 'middle' }} />
                    Layout
                  </Typography>
                  
                  <Box sx={{ mb: 3 }}>
                    <Typography variant="subtitle1" gutterBottom>Border Radius</Typography>
                    <Slider
                      value={localSettings.borderRadius}
                      onChange={(_, value) => handleSettingChange('borderRadius', value)}
                      min={0}
                      max={16}
                      step={1}
                      marks
                      valueLabelDisplay="auto"
                    />
                  </Box>
                  
                  <Box sx={{ mb: 3 }}>
                    <Typography variant="subtitle1" gutterBottom>Spacing</Typography>
                    <Slider
                      value={localSettings.spacing}
                      onChange={(_, value) => handleSettingChange('spacing', value)}
                      min={4}
                      max={16}
                      step={1}
                      marks
                      valueLabelDisplay="auto"
                    />
                  </Box>
                </CardContent>
              </Card>
            </Grid>
            
            <Grid item xs={12} md={6}>
              <Card>
                <CardContent>
                  <Typography variant="h6" gutterBottom>
                    <AnimationIcon sx={{ mr: 1, verticalAlign: 'middle' }} />
                    Effects
                  </Typography>
                  
                  <FormControlLabel
                    control={
                      <Switch
                        checked={localSettings.animations}
                        onChange={(e) => handleSettingChange('animations', e.target.checked)}
                        color="primary"
                      />
                    }
                    label="Enable Animations"
                  />
                </CardContent>
              </Card>
            </Grid>
          </Grid>
          
          <Box sx={{ display: 'flex', justifyContent: 'flex-end', gap: 1, mt: 2 }}>
            <Button 
              variant="outlined" 
              onClick={handleCancel}
              startIcon={<CancelIcon />}
            >
              Cancel
            </Button>
            <Button 
              variant="contained" 
              onClick={handleSave}
              startIcon={<SaveIcon />}
            >
              Save
            </Button>
          </Box>
        </Box>
      </TabPanel>

      <TabPanel value={activeTab} index={2}>
        <Box sx={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
          <Typography variant="h5" gutterBottom>
            Security Settings
          </Typography>
          
          <Card>
            <CardContent>
              <Typography variant="h6" gutterBottom>
                Password
              </Typography>
              <Button variant="outlined">Change Password</Button>
            </CardContent>
          </Card>
          
          <Card>
            <CardContent>
              <Typography variant="h6" gutterBottom>
                Two-Factor Authentication
              </Typography>
              <FormControlLabel
                control={<Switch />}
                label="Enable Two-Factor Authentication"
              />
            </CardContent>
          </Card>
          
          <Card>
            <CardContent>
              <Typography variant="h6" gutterBottom>
                Login History
              </Typography>
              <Typography variant="body2">
                Last login: {new Date().toLocaleString()}
              </Typography>
            </CardContent>
          </Card>
        </Box>
      </TabPanel>
    </Paper>

    {/* Color Picker Dialogs */}
    <Dialog
      open={showPrimaryColorPicker}
      onClose={handleCloseColorPickers}
      maxWidth="xs"
      fullWidth
    >
      <DialogTitle>Choose Primary Color</DialogTitle>
      <DialogContent>
        <ChromePicker
          color={localSettings.primaryColor}
          onChange={handlePrimaryColorChange}
        />
      </DialogContent>
      <DialogActions>
        <Button onClick={handleCloseColorPickers}>Close</Button>
      </DialogActions>
    </Dialog>

    <Dialog
      open={showSecondaryColorPicker}
      onClose={handleCloseColorPickers}
      maxWidth="xs"
      fullWidth
    >
      <DialogTitle>Choose Secondary Color</DialogTitle>
      <DialogContent>
        <ChromePicker
          color={localSettings.secondaryColor}
          onChange={handleSecondaryColorChange}
        />
      </DialogContent>
      <DialogActions>
        <Button onClick={handleCloseColorPickers}>Close</Button>
      </DialogActions>
    </Dialog>

    {/* Delete Account Confirmation Dialog */}
    <Dialog
      open={deleteConfirmOpen}
      onClose={() => setDeleteConfirmOpen(false)}
    >
      <DialogTitle>Delete Account</DialogTitle>
      <DialogContent>
        <Typography>
          Are you sure you want to delete your account? This action cannot be undone.
        </Typography>
      </DialogContent>
      <DialogActions>
        <Button onClick={() => setDeleteConfirmOpen(false)}>Cancel</Button>
        <Button onClick={handleDeleteAccount} color="error" disabled={loading}>
          {loading ? <CircularProgress size={24} /> : 'Delete'}
        </Button>
      </DialogActions>
    </Dialog>
  );
};

export default SettingsPanel; 