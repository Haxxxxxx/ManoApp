rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isTripOwner(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid;
    }
    
    function isTripCollaborator(tripId) {
      let trip = get(/databases/$(database)/documents/trips/$(tripId)).data;
      return trip.userId == request.auth.uid || 
             (trip.collaborators != null && trip.collaborators[request.auth.uid] != null);
    }
    
    // Trips collection rules
    match /trips/{tripId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && isTripOwner(tripId);
      
      // Songs subcollection rules
      match /songs/{songId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && isTripCollaborator(tripId);
      }
    }
    
    // Songs collection rules
    match /songs/{songId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && isTripCollaborator(resource.data.tripId);
    }

    // Artist profiles collection rules
    match /artistProfiles/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}