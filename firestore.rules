rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isCollaborator(collaborators) {
      return isAuthenticated() && collaborators is list && request.auth.uid in collaborators;
    }

    function hasAccess(userId, collaborators) {
      return isOwner(userId) || isCollaborator(collaborators);
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Trips collection
    match /trips/{tripId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        (resource.data.collaborators is list && request.auth.uid in resource.data.collaborators)
      );
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.collaborators is list && request.auth.uid in resource.data.collaborators)
      );

      // Trip logs subcollection
      match /logs/{logId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.collaborators
        );
        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.collaborators
        );
      }
    }

    // Songs collection
    match /songs/{songId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        exists(/databases/$(database)/documents/trips/$(resource.data.tripId)) &&
        (
          get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.userId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.collaborators
        )
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid &&
        exists(/databases/$(database)/documents/trips/$(request.resource.data.tripId)) &&
        (
          get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.userId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.collaborators
        )
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        exists(/databases/$(database)/documents/trips/$(resource.data.tripId)) &&
        (
          get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.userId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.collaborators
        )
      );
    }

    // Artist profiles collection
    match /artists/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Artist profiles collection (alternative path)
    match /artistProfiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // User settings collection
    match /userSettings/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
