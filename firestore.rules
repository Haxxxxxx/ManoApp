rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    // Any authenticated user can read (needed for collaborator display names/avatars)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Albums collection
    match /albums/{albumId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Trips collection
    match /trips/{tripId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        (resource.data.collaborators is list && request.auth.uid in resource.data.collaborators)
      );
      // Allow listing trips with specific queries for collaborators
      allow list: if isAuthenticated() && (
        // Allow listing own trips
        request.query.filters.userId == request.auth.uid ||
        // Allow listing collaborative trips
        (request.query.filters['collaborators'] is list && 
         request.auth.uid in request.query.filters['collaborators'])
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.collaborators is list && request.auth.uid in resource.data.collaborators)
      );
      // Only the owner can delete a project — collaborators can edit, not destroy
      allow delete: if isOwner(resource.data.userId);

      // Trip logs subcollection
      match /logs/{logId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.collaborators
        );
        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.collaborators
        );
      }
    }

    // Songs collection
    // Note: AI metadata fields (metadata.aiMetadata, metadata.suggestedTags) are included
    // in the metadata object and are covered by the update rules below
    match /songs/{songId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        exists(/databases/$(database)/documents/trips/$(resource.data.tripId)) &&
        (
          get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.userId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.collaborators
        )
      );
      // Allow users to list their own songs
      allow list: if isAuthenticated() && request.query.limit <= 1000 && (
        request.query.filters.userId == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/trips/$(request.query.filters.tripId)) &&
          (
            get(/databases/$(database)/documents/trips/$(request.query.filters.tripId)).data.userId == request.auth.uid ||
            request.auth.uid in get(/databases/$(database)/documents/trips/$(request.query.filters.tripId)).data.collaborators
          )
        )
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Allow updates including AI metadata fields (metadata.aiMetadata, metadata.suggestedTags)
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        exists(/databases/$(database)/documents/trips/$(resource.data.tripId)) &&
        (
          get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.userId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.collaborators
        )
      );
    }

    // Artist profiles collection
    // Any authenticated user can read (needed for collaborator display names)
    match /artists/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Artist profiles collection (alternative path)
    // Any authenticated user can read (needed for collaborator display names)
    match /artistProfiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // User settings collection
    match /userSettings/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // Releases collection
    match /releases/{releaseId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        exists(/databases/$(database)/documents/trips/$(resource.data.projectId)) &&
        (
          get(/databases/$(database)/documents/trips/$(resource.data.projectId)).data.userId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/trips/$(resource.data.projectId)).data.collaborators
        )
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        exists(/databases/$(database)/documents/trips/$(resource.data.projectId)) &&
        (
          get(/databases/$(database)/documents/trips/$(resource.data.projectId)).data.userId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/trips/$(resource.data.projectId)).data.collaborators
        )
      );
      // Only the owner can delete a release — deleting mid-distribution would
      // orphan provider submission state
      allow delete: if isOwner(resource.data.userId);

      // Provider submissions subcollection — server-only (Admin SDK bypasses
      // rules). Clients read via the getReleaseSubmissions callable; direct
      // writes would let a client fake a 'completed' distribution.
      match /submissions/{providerId} {
        allow read, write: if false;
      }
    }

    // Comments collection
    match /comments/{commentId} {
      allow read: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        exists(/databases/$(database)/documents/trips/$(resource.data.projectId)) &&
        (
          get(/databases/$(database)/documents/trips/$(resource.data.projectId)).data.userId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/trips/$(resource.data.projectId)).data.collaborators
        )
      );
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        exists(/databases/$(database)/documents/trips/$(resource.data.projectId)) &&
        (
          get(/databases/$(database)/documents/trips/$(resource.data.projectId)).data.userId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/trips/$(resource.data.projectId)).data.collaborators
        )
      );
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Connectors collection (OAuth integrations)
    match /connectors/{connectorId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Assets collection (imported files)
    match /assets/{assetId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.projectId != null &&
         exists(/databases/$(database)/documents/trips/$(resource.data.projectId)) &&
         (
           get(/databases/$(database)/documents/trips/$(resource.data.projectId)).data.userId == request.auth.uid ||
           request.auth.uid in get(/databases/$(database)/documents/trips/$(resource.data.projectId)).data.collaborators
         ))
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.projectId != null &&
         exists(/databases/$(database)/documents/trips/$(resource.data.projectId)) &&
         (
           get(/databases/$(database)/documents/trips/$(resource.data.projectId)).data.userId == request.auth.uid ||
           request.auth.uid in get(/databases/$(database)/documents/trips/$(resource.data.projectId)).data.collaborators
         ))
      );
    }

    // OAuth states collection (temporary, for CSRF protection)
    match /oauthStates/{stateId} {
      allow read, write: if false; // Only server-side access
    }

    // Presets collection (export presets)
    match /presets/{presetId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Submissions collection
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Streaming stats collection
    match /streamingStats/{statId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Revenue collection
    match /revenue/{entryId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
