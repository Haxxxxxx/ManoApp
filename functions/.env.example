# Revelator white-label distribution
# Mode: "mock" (default) simulates the full distribution flow without credentials.
# Switch to "live" only after partner onboarding provides real credentials.
REVELATOR_MODE=mock
REVELATOR_API_URL=https://api.revelator.com
REVELATOR_CLIENT_ID=
REVELATOR_CLIENT_SECRET=

# Job queue backend
# "inline" (default): jobs run synchronously inside the calling invocation — fine for
# mock mode and low volume. "cloud-tasks": durable Cloud Tasks dispatch with retries;
# requires the *Task functions deployed and the Cloud Tasks API enabled.
QUEUE_MODE=inline

# SoundCloud OAuth (existing integration)
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_CALLBACK_URL=

# Stripe subscriptions (monetization)
# Mode: "mock" (default) runs the full checkout/subscription flow with NO real
# Stripe keys — createCheckoutSession returns a URL that bounces back to your
# successUrl and the user's subscriptions/{uid} doc is written immediately, so
# the plan is granted end-to-end without Stripe. Switch to "live" ONLY after
# STRIPE_SECRET_KEY is set (mode auto-falls back to mock if the key is absent).
STRIPE_MODE=mock
STRIPE_SECRET_KEY=
# Webhook signing secret from the Stripe dashboard (live mode only). Required to
# verify stripeWebhook signatures; mock mode ignores it.
STRIPE_WEBHOOK_SECRET=

# planId -> Stripe Price ID mapping. Create recurring Prices in Stripe and paste
# their price_... ids here. Only the paid tiers have prices (free has none).
# Monthly:
STRIPE_PRICE_INDIE_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_LABEL_MONTHLY=
# Yearly (optional — only needed if you offer annual billing):
STRIPE_PRICE_INDIE_YEARLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_LABEL_YEARLY=
