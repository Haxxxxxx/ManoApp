# Revelator white-label distribution
# Mode: "mock" (default) simulates the full distribution flow without credentials.
# Switch to "live" only after partner onboarding provides real credentials.
REVELATOR_MODE=mock
REVELATOR_API_URL=https://api.revelator.com
REVELATOR_CLIENT_ID=
REVELATOR_CLIENT_SECRET=

# Job queue backend
# "inline" (default): jobs run synchronously inside the calling invocation — fine for
# mock mode and low volume. "cloud-tasks": durable Cloud Tasks dispatch with retries;
# requires the *Task functions deployed and the Cloud Tasks API enabled.
QUEUE_MODE=inline

# SoundCloud OAuth (existing integration)
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_CALLBACK_URL=
